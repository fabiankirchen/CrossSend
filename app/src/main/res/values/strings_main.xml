    <!-- Local Network Permission & Privacy Notice -->
    <string name="wifi_error_local_network_permission">Local network permission is required to find and connect to CrossPoint.</string>
    <string name="settings_section_privacy">About &amp; Privacy Notice</string>
    <string name="settings_privacy_summary">CrossSend works completely locally without user accounts, analytics, or third-party servers.</string>
    <string name="settings_privacy_button">View Privacy Notice</string>
    <string name="settings_privacy_dialog_title">Privacy Notice</string>
    <string name="settings_privacy_dialog_body">• Local-only storage: Your library, feeds, and domain rules are stored exclusively in a local Room database on your device.\n\n• No tracking or ads: CrossSend contains no telemetry, analytics, crash trackers, or advertising SDKs.\n\n• Cloud backups disabled: Private databases, preferences, and WebView login cookies are excluded from Android cloud and device backups.\n\n• Direct device transfer: Documents and sleep screens are transferred directly to your CrossPoint reader over your local Wi-Fi or reader hotspot without intermediate servers.\n\n• Direct web &amp; RSS fetches: Web articles and RSS feeds are fetched directly via HTTPS from the sources you choose.</string>
    <string name="settings_privacy_dialog_close">Close</string>

